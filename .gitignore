# ------------------------------------------------------------------------------
# 6. Project Data, Weights, Outputs, and Experiments
# ------------------------------------------------------------------------------
# Raw and Processed Datasets
data/**/*.csv
data/**/*.xlsx
data/**/*.json
data/**/*.txt
!data/**/.gitkeep

# Machine Learning Artifacts & Weights (Models, Vectorizers, SVDs)
artifacts/**/*
!artifacts/**/.gitkeep

# Production Pipeline Outputs (Reports, Scored CSVs)
# outputs/**/*
!outputs/**/.gitkeep

# Legacy reports at repo root — use outputs/reports/ instead
reports/

# Experimentation History & Logs (Ignore large data logs and outputs)
experiments/**/*
!experiments/**/*.py
!experiments/**/*.md
!experiments/**/.gitkeep
!experiments/**/docs

outputs/
*.log