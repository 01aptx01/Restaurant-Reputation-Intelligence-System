# 2. Node.js & Web App
# ------------------------------------------------------------------------------
node_modules/
web_app/node_modules/
*.tsbuildinfo
web_app/dist/
web_app/out/
web_app/coverage/
web_app/scored_reviews.json
.eslintcache

# ------------------------------------------------------------------------------
